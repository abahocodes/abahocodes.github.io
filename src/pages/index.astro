---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SocialLink from '../components/SocialLink.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ResumeViewer from '../components/ResumeViewer.astro';
import ObfuscatedEmail from '../components/ObfuscatedEmail.astro';
import ObfuscatedPhone from '../components/ObfuscatedPhone.astro';

import person from '../data/person.json';
import socials from '../data/socials.json';
import heroStats from '../data/hero-stats.json';
import aboutFacts from '../data/about-facts.json';
import education from '../data/education.json';
import experience from '../data/experience.json';
import projects from '../data/projects.json';
import skills from '../data/skills.json';
---

<Layout title={`${person.name} — ${person.tagline}`}>
  <Nav socials={socials} emailUser={person.emailUser} emailDomain={person.emailDomain} />

  <!-- ── HERO ── -->
  <div id="hero" class="flex min-h-screen items-center px-6 pb-12 pt-28 md:px-12 md:pb-16 md:pt-32">
    <div class="mx-auto grid w-full max-w-5xl grid-cols-1 gap-10 md:grid-cols-2 md:gap-16">
      <div class="flex flex-col justify-center">
        <p class="mb-6 font-mono text-2xs uppercase tracking-widest text-site-accent">
          {person.tagline} — {person.location}
        </p>
        <h1
          class="mb-6 font-playfair font-bold leading-none tracking-tight"
          style="font-size: clamp(3rem, 6vw, 5.5rem)"
        >
          {person.name.split(' ')[0]}<br />
          <span class="text-site-accent">{person.name.split(' ')[1]}</span>
        </h1>
        <p class="mb-10 max-w-md text-base leading-loose text-site-muted">
          {person.heroSubtitle}
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="/resume.pdf"
            class="border border-site-accent bg-site-accent px-6 py-3 font-mono text-xs uppercase tracking-widest text-site-bg no-underline transition-all hover:bg-transparent hover:text-site-accent"
          >
            Download Resume
          </a>
          <a
            href="#contact"
            class="border border-site-border px-6 py-3 font-mono text-xs uppercase tracking-widest text-site-muted no-underline transition-all hover:border-site-muted hover:text-site-text"
          >
            Get in Touch
          </a>
        </div>
      </div>

      <div
        class="flex flex-col justify-center border-t border-site-border pt-8 md:border-l md:border-t-0 md:pl-16 md:pt-0"
      >
        {
          heroStats.map((stat) => (
            <div class="border-b border-site-border py-6 first:border-t first:border-site-border">
              <p class="mb-1 font-mono text-2xs uppercase tracking-widest text-site-muted">
                {stat.label}
              </p>
              <p class="text-[0.95rem] text-site-text" set:html={stat.value} />
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- ── ABOUT ── -->
  <section
    id="about"
    class="mx-auto max-w-5xl border-t border-site-border px-6 py-16 md:px-12 md:py-24"
  >
    <SectionHeader number="01" title="About" />
    <div class="fade-in grid grid-cols-1 items-start gap-10 md:grid-cols-[260px_1fr_1fr] md:gap-16">
      <div>
        <img
          src="/photo.jpg"
          alt={person.name}
          class="block h-auto w-full max-w-[260px] md:max-w-none"
          style="filter: grayscale(20%)"
        />
      </div>

      <div class="space-y-5 text-[0.95rem] leading-loose text-site-muted">
        {person.bio.map((para) => <p set:html={para} />)}
      </div>

      <!-- Facts + social rows -->
      <div>
        {
          aboutFacts.map((f) => (
            <div class="flex items-center justify-between border-b border-site-border py-4 text-sm first:border-t first:border-site-border">
              <span class="font-mono text-2xs uppercase tracking-wider text-site-muted">
                {f.key}
              </span>
              <span class="text-right text-site-text" set:html={f.val} />
            </div>
          ))
        }

        <!-- Non-email socials with icons -->
        {
          socials
            .filter((s) => !s.obfuscated)
            .map((s) => (
              <div class="flex items-center justify-between border-b border-site-border py-4 text-sm">
                <span class="font-mono text-2xs uppercase tracking-wider text-site-muted">
                  {s.label}
                </span>
                <SocialLink
                  href={s.href}
                  label={s.display}
                  icon={s.icon}
                  class="gap-1.5 text-sm text-site-accent"
                />
              </div>
            ))
        }

        <!-- Obfuscated email row with icon -->
        <div class="flex items-center justify-between border-b border-site-border py-4 text-sm">
          <span class="font-mono text-2xs uppercase tracking-wider text-site-muted">Email</span>
          <ObfuscatedEmail
            user={person.emailUser}
            domain={person.emailDomain}
            class="text-sm text-site-accent no-underline"
          />
        </div>

        <!-- Obfuscated phone row -->
        <div class="flex items-center justify-between border-b border-site-border py-4 text-sm">
          <span class="font-mono text-2xs uppercase tracking-wider text-site-muted">Phone</span>
          <ObfuscatedPhone parts={person.phoneParts} class="text-site-text" />
        </div>
      </div>
    </div>
  </section>

  <!-- ── EXPERIENCE ── -->
  <section
    id="experience"
    class="mx-auto max-w-5xl border-t border-site-border px-6 py-16 md:px-12 md:py-24"
  >
    <SectionHeader number="02" title="Experience" />
    <div>
      {experience.map((job) => <ExperienceItem {...job} />)}
    </div>
  </section>

  <!-- ── EDUCATION ── -->
  <section
    id="education"
    class="mx-auto max-w-5xl border-t border-site-border px-6 py-16 md:px-12 md:py-24"
  >
    <SectionHeader number="03" title="Education" />
    <div class="fade-in grid grid-cols-1 gap-6 sm:grid-cols-2">
      {
        education.map((e) => (
          <div class="border border-site-border bg-site-bg2 p-8">
            <p class="mb-4 font-mono text-2xs tracking-widest text-site-accent">{e.years}</p>
            <h3 class="mb-2 font-playfair text-2xl font-normal">{e.school}</h3>
            <p class="text-sm text-site-muted">{e.degree}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ── PROJECTS ── -->
  <section
    id="projects"
    class="mx-auto max-w-5xl border-t border-site-border px-6 py-16 md:px-12 md:py-24"
  >
    <SectionHeader number="04" title="Projects" />
    <div class="fade-in grid grid-cols-1 gap-6 sm:grid-cols-2">
      {projects.map((p) => <ProjectCard {...p} />)}
    </div>
  </section>

  <!-- ── SKILLS ── -->
  <section
    id="skills"
    class="mx-auto max-w-5xl border-t border-site-border px-6 py-16 md:px-12 md:py-24"
  >
    <SectionHeader number="05" title="Skills" />
    <div class="fade-in grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        skills.map((group) => (
          <div class="border border-site-border bg-site-bg2 p-7">
            <p class="mb-5 font-mono text-2xs uppercase tracking-widest text-site-accent">
              {group.group}
            </p>
            <div class="flex flex-wrap gap-2">
              {group.tags.map((tag) => (
                <span class="border border-site-border bg-site-bg3 px-3 py-1 font-mono text-xs tracking-wide text-site-muted">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ── RESUME VIEWER ── -->
  <section
    id="resume"
    class="mx-auto max-w-5xl border-t border-site-border px-6 py-16 md:px-12 md:py-24"
  >
    <SectionHeader number="06" title="Resume" />
    <ResumeViewer />
  </section>

  <!-- ── CONTACT ── -->
  <section
    id="contact"
    class="mx-auto max-w-5xl border-t border-site-border px-6 py-16 text-center md:px-12 md:py-24"
  >
    <div class="fade-in mx-auto max-w-lg">
      <p class="mb-4 font-mono text-2xs uppercase tracking-widest text-site-accent">07 — Contact</p>
      <h2 class="mb-4 font-playfair text-5xl font-normal">Let's Talk</h2>
      <p class="mb-10 text-sm leading-loose text-site-muted">
        Whether you're interested in LLMGraph, have a technical problem worth solving, or just want
        to connect — my inbox is open.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <ObfuscatedEmail
          user={person.emailUser}
          domain={person.emailDomain}
          label="Send an Email"
          class="border border-site-accent bg-site-accent px-6 py-3 font-mono text-xs uppercase tracking-widest text-site-bg no-underline transition-all hover:bg-transparent hover:text-site-accent"
        />
        {
          socials
            .filter((s) => !s.obfuscated)
            .map((s) => (
              <SocialLink
                href={s.href}
                label={s.label}
                icon={s.icon}
                class="gap-2 border border-site-border px-6 py-3 font-mono text-xs uppercase tracking-widest text-site-muted transition-all hover:border-site-muted hover:text-site-text"
              />
            ))
        }
      </div>
    </div>
  </section>

  <!-- ── FOOTER ── -->
  <footer
    class="flex flex-col items-center justify-between gap-4 border-t border-site-border px-6 py-8 md:flex-row md:px-12"
  >
    <p class="font-mono text-2xs tracking-wider text-site-muted">
      © {new Date().getFullYear()}
      {person.name}
    </p>
    <div class="flex items-center gap-5">
      {
        socials
          .filter((s) => !s.obfuscated)
          .map((s) => (
            <SocialLink
              href={s.href}
              label={s.label}
              icon={s.icon}
              iconOnly={true}
              class="text-site-muted hover:text-site-accent"
            />
          ))
      }
      <!-- Obfuscated email icon in footer -->
      <a
        href="#"
        class="obf-email inline-flex items-center text-site-muted transition-colors hover:text-site-accent"
        data-u={btoa(person.emailUser)}
        data-d={btoa(person.emailDomain)}
        data-icon-only="true"
        aria-label="Email"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
        <span class="sr-only">Email</span>
      </a>
    </div>
  </footer>
</Layout>
