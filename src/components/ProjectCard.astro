---
interface Props {
  tag: string;
  title: string;
  description: string;
  reportUrl?: string;
  videoUrl?: string;
  pageUrl?: string;
  pageLabel?: string;
}
const {
  tag,
  title,
  description,
  reportUrl,
  videoUrl,
  pageUrl,
  pageLabel = 'View Project',
} = Astro.props;
---

<div class="border border-site-border bg-site-bg2 p-8 transition-colors hover:border-site-accent">
  <p class="mb-3 font-mono text-2xs uppercase tracking-widest text-site-accent2">
    {tag}
  </p>
  <h3 class="mb-3 font-playfair text-xl font-normal">{title}</h3>
  <p class="text-sm leading-7 text-site-muted">{description}</p>

  {
    pageUrl && (
      <a
        href={pageUrl}
        class="mt-4 block font-mono text-xs tracking-wider text-site-accent no-underline hover:underline"
      >
        {pageLabel} →
      </a>
    )
  }
  {
    reportUrl && (
      <a
        href={reportUrl}
        class="mt-4 block font-mono text-xs tracking-wider text-site-accent no-underline hover:underline"
      >
        Read Report →
      </a>
    )
  }
  {
    videoUrl && (
      <div class="relative mt-4 pt-[56.25%]">
        <iframe
          src={videoUrl}
          frameborder="0"
          allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          class="absolute left-0 top-0 h-full w-full"
        />
      </div>
    )
  }
</div>
