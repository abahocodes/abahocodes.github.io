---
interface Props {
  number: string;
  title: string;
}
const { number, title } = Astro.props;
---

<div class="fade-in mb-14 flex items-center gap-6">
  <span class="font-mono text-2xs uppercase tracking-widest text-site-accent">
    {number}
  </span>
  <h2 class="font-playfair text-4xl font-normal tracking-tight">
    {title}
  </h2>
  <div class="h-px flex-1 bg-site-border"></div>
</div>
