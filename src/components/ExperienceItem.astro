---
interface Props {
  date: string;
  company: string;
  companyUrl?: string;
  location: string;
  role: string;
  bullets: string[];
}
const { date, company, companyUrl, location, role, bullets } = Astro.props;
---

<div
  class="fade-in grid grid-cols-1 gap-4 border-b border-site-border py-10 first:border-t first:border-site-border md:grid-cols-[200px_1fr] md:gap-12"
>
  <div class="pt-1">
    <p class="mb-1 font-mono text-2xs tracking-wider text-site-muted">{date}</p>
    <p class="mb-1 text-sm font-medium text-site-accent">
      {
        companyUrl ? (
          <a
            href={companyUrl}
            target="_blank"
            class="text-site-accent no-underline hover:underline"
          >
            {company}
          </a>
        ) : (
          company
        )
      }
    </p>
    <p class="font-mono text-2xs tracking-wide text-site-muted">{location}</p>
  </div>

  <div>
    <p class="mb-4 font-playfair text-lg font-normal text-site-text">{role}</p>
    <ul class="flex list-none flex-col gap-2">
      {
        bullets.map((bullet) => (
          <li
            class="relative pl-5 text-sm leading-7 text-site-muted before:absolute before:left-0 before:top-0.5 before:text-xs before:text-site-accent before:content-['—']"
            set:html={bullet}
          />
        ))
      }
    </ul>
  </div>
</div>
