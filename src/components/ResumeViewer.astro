---
/**
 * Scrollable inline PDF viewer for the resume.
 * Falls back to a download link if the browser can't embed PDFs (mobile).
 */
interface Props {
  src?: string;
}
const { src = '/resume.pdf' } = Astro.props;
---

<div
  class="fade-in relative w-full overflow-hidden rounded-none border border-site-border"
  style="height: 680px;"
>
  <!-- Desktop: embedded PDF viewer -->
  <object
    data={src}
    type="application/pdf"
    class="pdf-embed block h-full w-full"
    aria-label="Resume PDF viewer"
  >
    <!-- Fallback for mobile / browsers without PDF support -->
    <div
      class="flex h-full flex-col items-center justify-center gap-5 bg-site-bg2 font-mono text-sm text-site-muted"
    >
      <svg
        width="40"
        height="40"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        class="text-site-accent opacity-60"
      >
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
        <polyline points="14 2 14 8 20 8"></polyline>
        <line x1="16" y1="13" x2="8" y2="13"></line>
        <line x1="16" y1="17" x2="8" y2="17"></line>
        <polyline points="10 9 9 9 8 9"></polyline>
      </svg>
      <p class="text-xs tracking-wider text-site-muted">
        PDF preview not available in this browser
      </p>
      <a
        href={src}
        download
        class="border border-site-accent bg-site-accent px-5 py-2.5 font-mono text-xs uppercase tracking-widest text-site-bg no-underline transition-all hover:bg-transparent hover:text-site-accent"
      >
        Download Resume
      </a>
    </div>
  </object>
</div>

<!-- Toolbar below viewer -->
<div class="mt-3 flex items-center justify-between px-1">
  <p class="font-mono text-2xs tracking-wider text-site-muted">resume.pdf · scroll to read</p>
  <a
    href={src}
    download
    class="font-mono text-2xs uppercase tracking-widest text-site-accent no-underline hover:underline"
  >
    Download ↓
  </a>
</div>
